# Backend only. Never put this value in a VITE_* variable or commit it.
# The application reads process environment variables; it does not load .env automatically.
SERPAPI_KEY=

# Local application allocation, not the SerpApi account's remaining balance.
# Leave part of a shared 250-search account for teammates. Cached searches spend no calls.
SERPAPI_REQUEST_BUDGET=50

# Persistent cache and request ledger directory. Mount this directory in deployment.
VERSIONVERDICT_CACHE_DIR=.cache/versionverdict
